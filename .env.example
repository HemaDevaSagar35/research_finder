# Copy to .env and fill in the blocks you use. .env is gitignored.
#
# Pick the active provider here; that provider's block below is what kicks in.
# Explicit function arguments always take precedence over env values.
PROVIDER=openai

# --- OPENAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.2
OPENAI_MAX_TOKENS=4096
# OPENAI_TEMPERATURE=0.7
# OPENAI_BASE_URL=

# --- GEMINI ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MAX_TOKENS=4096
# GEMINI_TEMPERATURE=0.7
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# --- DEEPSEEK ---
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_MAX_TOKENS=500000
# Current DeepSeek Flash API hard output maximum (384 Ki tokens).
DEEPSEEK_OUTPUT_TOKEN_LIMIT=393216
# DEEPSEEK_TEMPERATURE=0.7
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Max in-flight async LLM requests
LLM_CONCURRENCY=100
# Per-request timeout (s) and SDK retries for ordinary calls (SDK defaults).
# LLM_TIMEOUT=600
# LLM_MAX_RETRIES=2
# The long single-call stages (paper.json, summary.md) use these instead.
# LONG_CALL_TIMEOUT=1800
# LONG_CALL_RETRIES=1

# --- Page classification (extraction/classify_pages.py) ---
# Falls back to PROVIDER / its model when unset.
CLASSIFY_PROVIDER=deepseek
CLASSIFY_MODEL=deepseek-v4-flash

# --- Markdown extraction (extraction/pdf_to_markdown.py) ---
# Falls back to PROVIDER / its model when unset.
EXTRACT_PROVIDER=deepseek
EXTRACT_MODEL=deepseek-v4-flash

# --- Research JSON extraction (extraction/research_extract.py) ---
# Falls back to PROVIDER / its model when unset. Reasoning models help here.
RESEARCH_PROVIDER=deepseek
RESEARCH_MODEL=deepseek-v4-pro

# --- Paper summary (extraction/extract_summary.py) ---
# Falls back to PROVIDER / its model when unset.
SUMMARY_PROVIDER=deepseek
SUMMARY_MODEL=deepseek-v4-pro

# --- Online query planner (research/query_planner.py) ---
# Falls back to PROVIDER / its model when unset. Choose a chat model.
# QUERY_PLANNER_PROVIDER=
# QUERY_PLANNER_MODEL=

# --- Cross-paper reasoning (reasoning/cross_paper.py) ---
# Falls back to PROVIDER / its model when unset. A reasoning model helps for
# the draft; the review pass may use a cheaper model ONLY after a quality
# comparison (defaults to REASON_MODEL). Budgets are CLI flags (--max-calls,
# --max-review-pages, ...), see docs/cross_paper_reasoner.md.
REASON_PROVIDER=deepseek
REASON_MODEL=deepseek-v4-pro
# REASON_REVIEW_MODEL=
# Review output allowance; --max-review-output-tokens overrides this.
# REASON_MAX_DRAFT_INPUT_TOKENS=500000
# REASON_MAX_DRAFT_OUTPUT_TOKENS=500000
# REASON_MAX_REVIEW_INPUT_TOKENS=500000
# REASON_MAX_REVIEW_OUTPUT_TOKENS=500000
# Approximate character allowance; the complete draft prompt still has its token guard.
# REASON_MAX_BUNDLE_CHARS=2000000

# --- Opportunity mining (opportunities/miner.py) ---
# Provider/model fall back to general PROVIDER and that provider's model.
# OPPORTUNITY_PROVIDER=
# OPPORTUNITY_MODEL=
# OPPORTUNITY_REVIEW_MODEL=
# Output allowances; corresponding CLI flags override them.
# OPPORTUNITY_MAX_INPUT_TOKENS=500000
# OPPORTUNITY_MAX_OUTPUT_TOKENS=500000
# Review falls back to REASON_MAX_REVIEW_OUTPUT_TOKENS, then 500000.
# OPPORTUNITY_REVIEW_MAX_OUTPUT_TOKENS=500000
# All sources enter one proposal by default; --batch-size > 0 explicitly enables batching.
# Other budgets/concurrency are CLI flags; see docs/opportunity_miner.md.

# --- Index records (indexing/flatten.py) ---
# Records longer than this many chars are split into sentence-aligned chunks.
# 4000 chars (~1000-1300 tokens) keeps the one-record-per-paper types
# (summary, method, paper_card, ...) in a single vector; far inside the
# Qwen3-Embedding (32k) and OpenAI (8k) windows. The local bge-small dev
# model truncates at 512 tokens; drop to ~1600 if you only use that.
CHUNK_CHARS=4000

# --- Index embeddings (indexing/build_index.py, indexing/search.py) ---
# deepinfra | openai | gemini | local. Defaults per provider:
#   deepinfra  Qwen/Qwen3-Embedding-8B  open-weight, pay-per-token ($0.01/M),
#                                        needs DEEPINFRA_API_KEY
#   openai     text-embedding-3-small   needs OPENAI_API_KEY
#   gemini     gemini-embedding-001     needs GEMINI_API_KEY
#   local      BAAI/bge-small-en-v1.5   no key; fastembed downloads it
# Each provider/model/dim builds its own variant under index/embeddings/, so
# several can be compared on the same records (build_index --list, search
# --embedding <slug>). Queries are embedded with whatever built the chosen
# variant (its index_meta.json), not these settings.
EMBED_PROVIDER=deepinfra
# EMBED_MODEL=
# Matryoshka truncation for models that support it (Qwen3, OpenAI v3,
# Gemini). Default 1024 for deepinfra, native size otherwise.
# EMBED_DIM=1024
# Parallel embedding requests during build_index (default 8).
# EMBED_CONCURRENCY=8

# --- DeepInfra (open-weight models, pay per token) ---
DEEPINFRA_API_KEY=

# --- S3 artifact store (ingestion/, indexing/flatten.py --s3) ---
# Where extraction artifacts (markdown pages, paper.json, summary.md) are
# uploaded as soon as they are produced, one prefix per paper_id, e.g.
# s3://research-finder-2026/artifacts . Unset = local-only extraction.
# AWS auth is ambient: an EC2 instance role, or AWS_PROFILE locally.
S3_ARTIFACTS_URL=
# Where the downloaded PDFs were uploaded (same layout as papers/), e.g.
# s3://research-finder-2026/papers . When set, the worker fetches missing
# PDFs on demand (and deletes them after success), so the corpus never
# needs to be synced to the machine running extraction.
S3_PAPERS_URL=
# AWS_PROFILE=
# AWS_REGION=

# --- OpenSearch (indexing/opensearch_index.py) ---
# AWS managed-domain endpoint (recommended over Serverless, which disallows
# client-chosen _id and breaks idempotent re-indexing). amazonaws.com
# endpoints are SigV4-signed with the same AWS credentials as above;
# non-AWS endpoints (local docker) use OPENSEARCH_USER/PASSWORD or no auth.
OPENSEARCH_ENDPOINT=
# OPENSEARCH_INDEX_PREFIX=research
# OPENSEARCH_USER=
# OPENSEARCH_PASSWORD=

# --- OpenReview (for scrapper/download_papers.py) ---
OPENREVIEW_USERNAME=
OPENREVIEW_PASSWORD=

# --- Direction, hypothesis and experiment generation (directions/generator.py) ---
# Provider/model fall back to the general provider configuration.
# DIRECTION_PROVIDER=
# DIRECTION_MODEL=
# DIRECTION_MAX_INPUT_TOKENS=500000
# DIRECTION_MAX_OUTPUT_TOKENS=500000
# Explicit CLI settings override these; shared provider output caps still apply.
# See docs/direction_generator.md for the contract, budgets and validation.

# Landscape clustering has separate provider settings; use DeepInfra here too.
LANDSCAPE_NORMALIZE_EMBED_PROVIDER=deepinfra
LANDSCAPE_AGGREGATION_EMBED_PROVIDER=deepinfra

# Total input + output context, based on the configured DeepSeek model.
DEEPSEEK_CONTEXT_TOKEN_LIMIT=1048576
