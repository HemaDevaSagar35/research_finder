# Copy to .env and fill in the blocks you use. .env is gitignored.
#
# Pick the active provider here; that provider's block below is what kicks in.
# Explicit function arguments always take precedence over env values.
PROVIDER=openai

# --- OPENAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.2
OPENAI_MAX_TOKENS=4096
# OPENAI_TEMPERATURE=0.7
# OPENAI_BASE_URL=

# --- GEMINI ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MAX_TOKENS=4096
# GEMINI_TEMPERATURE=0.7
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# --- DEEPSEEK ---
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_MAX_TOKENS=4096
# DEEPSEEK_TEMPERATURE=0.7
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Max in-flight async LLM requests
LLM_CONCURRENCY=8

# --- Page classification (extraction/classify_pages.py) ---
# Falls back to PROVIDER / its model when unset.
CLASSIFY_PROVIDER=deepseek
CLASSIFY_MODEL=deepseek-v4-flash

# --- Markdown extraction (extraction/pdf_to_markdown.py) ---
# Falls back to PROVIDER / its model when unset.
EXTRACT_PROVIDER=deepseek
EXTRACT_MODEL=deepseek-v4-flash

# --- Research JSON extraction (extraction/research_extract.py) ---
# Falls back to PROVIDER / its model when unset. Reasoning models help here.
RESEARCH_PROVIDER=deepseek
RESEARCH_MODEL=deepseek-v4-pro

# --- Paper summary (extraction/extract_summary.py) ---
# Falls back to PROVIDER / its model when unset.
SUMMARY_PROVIDER=deepseek
SUMMARY_MODEL=deepseek-v4-pro

# --- Index records (indexing/flatten.py) ---
# Records longer than this many chars are split into sentence-aligned chunks.
# Default 2000 (~500 tokens) matches the local bge model's 512-token window.
# CHUNK_CHARS=2000

# --- Index embeddings (indexing/build_index.py, indexing/search.py) ---
# openai | gemini | local. "local" needs no API key (fastembed downloads
# BAAI/bge-small-en-v1.5 on first use). Queries are embedded with whatever
# built the index (recorded in index/index_meta.json), not this setting.
EMBED_PROVIDER=local
# EMBED_MODEL=

# --- OpenReview (for scrapper/download_papers.py) ---
OPENREVIEW_USERNAME=
OPENREVIEW_PASSWORD=
